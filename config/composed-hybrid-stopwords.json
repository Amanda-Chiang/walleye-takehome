{
  "top_k": 5,
  "retriever": {
    "class": "qasper_agent.retrieval.composed:ComposedRetriever",
    "chunker": {
      "class": "qasper_agent.retrieval.chunkers:WholeParagraph"
    },
    "index_text": {
      "class": "qasper_agent.retrieval.index_text:RawText"
    },
    "scorers": [
      {
        "class": "qasper_agent.retrieval.bm25:BM25Scorer",
        "k1": 1.5,
        "b": 0.75,
        "stopwords": true
      },
      {
        "class": "qasper_agent.retrieval.dense:DenseScorer",
        "embedding": {
          "model": "openai/text-embedding-3-small",
          "dimensions": 256,
          "batch_size": 32,
          "max_input_chars": 12000,
          "attempts": 3,
          "timeout_s": 60
        }
      }
    ],
    "fusion": {
      "class": "qasper_agent.retrieval.fusion:ReciprocalRankFusion",
      "k": 60
    }
  },
  "generator": {
    "temperature": 0,
    "max_tokens": 4096,
    "attempts": 3,
    "timeout_s": 60,
    "model": "openai/gpt-6-luna",
    "base_url": "https://openrouter.ai/api/v1",
    "reasoning": {
      "effort": "none"
    },
    "structured_output": true
  }
}
